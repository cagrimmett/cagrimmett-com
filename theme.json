{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "40rem",
			"wideSize": "40rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Paper", "color": "#faf8f4" },
				{ "slug": "base-2", "name": "Wash", "color": "#efe9dd" },
				{ "slug": "contrast", "name": "Ink", "color": "#23201b" },
				{ "slug": "contrast-2", "name": "Muted ink", "color": "#6e675b" },
				{ "slug": "contrast-3", "name": "Rule", "color": "#e3ddd1" },
				{ "slug": "accent-3", "name": "Rust", "color": "#c0451d" },
				{ "slug": "accent-4", "name": "Sage", "color": "#5d7052" }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "1rem" },
				{ "slug": "20", "name": "2", "size": "1.5rem" },
				{ "slug": "30", "name": "3", "size": "2.25rem" },
				{ "slug": "40", "name": "4", "size": "3.5rem" },
				{ "slug": "50", "name": "5", "size": "5rem" },
				{ "slug": "60", "name": "6", "size": "7rem" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "ET Book",
					"fontFamily": "\"ET Book\", \"Iowan Old Style\", Palatino, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "ET Book", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/et-book-roman-line-figures.woff" ] },
						{ "fontFamily": "ET Book", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": [ "file:./assets/fonts/et-book-display-italic-old-style-figures.woff" ] },
						{ "fontFamily": "ET Book", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/et-book-bold-line-figures.woff" ] }
					]
				},
				{ "slug": "ui", "name": "System UI", "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" },
				{ "slug": "mono", "name": "Mono", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" },
				{ "slug": "system-serif", "name": "Serif (legacy slug)", "fontFamily": "\"ET Book\", \"Iowan Old Style\", Palatino, Georgia, serif" },
				{ "slug": "system-sans-serif", "name": "Sans (legacy slug)", "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "1.6rem" },
				{ "slug": "x-large", "name": "X Large", "size": "2.2rem" },
				{ "slug": "xx-large", "name": "XX Large", "size": "2.8rem" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5"
		},
		"spacing": {
			"blockGap": "1.1rem",
			"padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent-3)" }
			},
			"heading": {
				"typography": { "fontWeight": "400", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.15" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "1.35rem" } },
			"h4": { "typography": { "fontSize": "1.25rem", "fontStyle": "italic" } },
			"h5": { "typography": { "fontSize": "1.25rem" } },
			"h6": { "typography": { "fontSize": "1.25rem" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--contrast)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "4px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "fontSize": "0.875rem" }
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--contrast-2)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--ui)", "fontSize": "0.8125rem" }
			}
		},
		"blocks": {
			"core/code": {
				"color": { "background": "var(--wp--preset--color--base-2)" },
				"border": { "radius": "4px", "width": "0" },
				"spacing": { "padding": { "top": "1rem", "right": "1rem", "bottom": "1rem", "left": "1rem" } },
				"typography": { "fontFamily": "var(--wp--preset--font-family--mono)", "fontSize": "0.875rem" }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--contrast-3)" }
			},
			"core/quote": {
				"typography": { "fontStyle": "italic" },
				"spacing": { "padding": { "left": "1.25rem" } }
			},
			"core/post-featured-image": {
				"border": { "radius": "0" }
			}
		}
	},
	"templateParts": [
		{ "name": "sidebar", "title": "Sidebar", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "comments", "title": "Author and comments", "area": "uncategorized" }
	]
}
